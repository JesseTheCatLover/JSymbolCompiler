PROJECT_NAME = RedleafEngine

OUTPUT_DIRECTORY = @JDOCGEN_OUTPUT_DIR@

GENERATE_HTML = NO
GENERATE_XML  = YES

XML_OUTPUT = xml

RECURSIVE = YES

INPUT = @ENGINE_ROOT@/Source/Engine\
@ENGINE_ROOT@/Source/EditorRuntime\
@ENGINE_ROOT@/Source/Editor\
@ENGINE_ROOT@/Source/Launch

OUTPUT_DIRECTORY = @OUTPUT_DIR@

# -----------------------------
# CORE EXTRACTION (balanced)
# -----------------------------
EXTRACT_ALL    = NO
EXTRACT_PRIVATE = YES
EXTRACT_STATIC  = YES

# Keep public API clean but still usable for engine introspection
HIDE_UNDOC_MEMBERS = YES
HIDE_UNDOC_CLASSES = NO

# -----------------------------
# PATH STRIP
# -----------------------------
FULL_PATH_NAMES = NO
STRIP_FROM_PATH = @ENGINE_ROOT@
STRIP_FROM_INC_PATH = @ENGINE_ROOT@

# -----------------------------
# SOURCE VISIBILITY (needed for editor-style docs)
# -----------------------------
SOURCE_BROWSER = YES
INLINE_SOURCES = YES

# -----------------------------
# RELATION GRAPH DATA (critical for UI later)
# -----------------------------
REFERENCES_RELATION     = YES
REFERENCED_BY_RELATION  = YES

INCLUDE_GRAPH           = YES
INCLUDED_BY_GRAPH       = YES

CALL_GRAPH              = YES
CALLER_GRAPH            = YES

CLASS_GRAPH             = YES
COLLABORATION_GRAPH     = YES

# -----------------------------
# GRAPHVIZ (dependency engine)
# -----------------------------
HAVE_DOT = YES
DOT_GRAPH_MAX_NODES = 100
MAX_DOT_GRAPH_DEPTH = 4

# Prevent graph explosion (VERY important for engine scale)
DOT_MULTI_TARGETS = YES
DOT_CLEANUP = YES

# -----------------------------
# CLEAN OUTPUT (important for pipeline)
# -----------------------------
EXCLUDE_PATTERNS = \
*.generated.h \
*/generated/* \
*/Private/ThirdParty/*

# -----------------------------
# PERFORMANCE / STABILITY
# -----------------------------
QUIET = YES
WARN_IF_UNDOCUMENTED = NO
WARN_IF_UNDOC_ENUM_VAL = NO